{
  "name": "agentry",
  "author": "Colin D'Souza",
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/react": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260224.1",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "^5"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "private": true,
  "scripts": {
    "test": "bun test --timeout 5000 ./packages/agentry/tests",
    "typecheck": "bun run --filter='./packages/*' typecheck",
    "build": "bun run --filter='./packages/agentry' build",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "lint": "oxlint packages/agentry/src packages/examples/src --max-warnings=0",
    "lint:fix": "oxlint packages/agentry/src packages/examples/src --fix",
    "format": "oxfmt --check packages/agentry/src packages/examples/src",
    "format:fix": "oxfmt --write packages/agentry/src packages/examples/src",
    "example:basic": "bun run packages/examples/src/basic.tsx",
    "example:create-ephemeral-subagent": "bun run packages/examples/src/create-ephemeral-subagent.tsx",
    "example:create-subagent": "bun run packages/examples/src/create-subagent.tsx",
    "example:dynamic-tools": "bun run packages/examples/src/dynamic-tools.tsx",
    "example:hooks": "bun run packages/examples/src/hooks.tsx",
    "example:subagents": "bun run packages/examples/src/subagents.tsx",
    "example:ctf": "bun run packages/examples/src/ctf.tsx",
    "example:anthropic:thinking": "bun run packages/examples/src/anthropic/thinking.tsx",
    "example:programmatic-spawn": "bun run packages/examples/src/programmatic-spawn.tsx",
    "example:openai:basic": "bun run packages/examples/src/openai/basic.tsx",
    "example:openai:subtools": "bun run packages/examples/src/openai/subtools-smoke.tsx",
    "example:openai:codex-subagent": "bun run packages/examples/src/openai/codex-subagent.tsx",
    "example:cross-provider:subagents": "bun run packages/examples/src/cross-provider/subagents.tsx",
    "example:compaction": "bun run packages/examples/src/compaction.tsx",
    "example:chatbot": "bun run packages/examples/src/chatbot.tsx",
    "example:interactive": "bun run packages/examples/src/interactive.tsx",
    "example:demo": "bun run packages/examples/src/demo.tsx",
    "example:tweet": "bun run packages/examples/src/tweet.tsx",
    "example:multi-provider": "bun run packages/examples/src/multi-provider.tsx",
    "example:mcp": "bun run packages/examples/src/mcp.tsx"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@anthropic-ai/sdk": "^0.71.2",
      "@types/react": "^19.2.14",
      "openai": "^6.23.0",
      "react": "^19.0.0",
      "zod": "^4.1.13"
    }
  }
}
