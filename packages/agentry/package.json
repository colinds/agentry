{
  "name": "agentry",
  "author": "Colin D'Souza",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Compose and reuse your AI agents like React components",
  "repository": {
    "type": "git",
    "url": "https://github.com/colinds/agentry"
  },
  "homepage": "https://github.com/colinds/agentry",
  "bugs": {
    "url": "https://github.com/colinds/agentry/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "react",
    "declarative",
    "reconciler",
    "framework",
    "pi",
    "multi-provider"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "bun run build",
    "prepack": "cp ../../README.md . && cp ../../LICENSE.md .",
    "postpack": "rm README.md LICENSE.md"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "eventemitter3": "^5.0.1",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "typebox": "1.3.7",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-reconciler": "^0.32.3",
    "@types/scheduler": "^0.26.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
